#include <iostream>
#include <vector>
#include <queue>

using namespace std;

class Graph {
private:
    int V;                          // Number of vertices
    vector<vector<int>> adj;        // Adjacency list

public:
    // Constructor
    Graph(int vertices) {
        V = vertices;
        adj.resize(V);
    }

    // Function to add an edge to the graph
    void addEdge(int u, int v, bool undirected = true) {
        adj[u].push_back(v);
        if (undirected) {
            adj[v].push_back(u);
        }
    }

    // Breadth-First Search (BFS) Traversal
    void BFS(int startVertex) {
        vector<bool> visited(V, false);
        queue<int> q;

        visited[startVertex] = true;
        q.push(startVertex);

        cout << "BFS Traversal (starting from " << startVertex << "): ";
        while (!q.empty()) {
            int curr = q.front();
            q.pop();
            cout << curr << " ";

            // Visit all adjacent unvisited vertices
            for (int neighbor : adj[curr]) {
                if (!visited[neighbor]) {
                    visited[neighbor] = true;
                    q.push(neighbor);
                }
            }
        }
        cout << endl;
    }

private:
    // Helper function for recursive DFS
    void DFSUtil(int curr, vector<bool>& visited) {
        visited[curr] = true;
        cout << curr << " ";

        for (int neighbor : adj[curr]) {
            if (!visited[neighbor]) {
                DFSUtil(neighbor, visited);
            }
        }
    }

public:
    // Depth-First Search (DFS) Traversal
    void DFS(int startVertex) {
        vector<bool> visited(V, false);
        cout << "DFS Traversal (starting from " << startVertex << "): ";
        DFSUtil(startVertex, visited);
        cout << endl;
    }
};

int main() {
    // Create a graph with 5 vertices (0 through 4)
    Graph g(5);

    // Adding edges
    g.addEdge(0, 1);
    g.addEdge(0, 4);
    g.addEdge(1, 2);
    g.addEdge(1, 3);
    g.addEdge(1, 4);
    g.addEdge(2, 3);
    g.addEdge(3, 4);

    // Perform BFS and DFS searches
    g.BFS(0);
    g.DFS(0);

    return 0;
}
